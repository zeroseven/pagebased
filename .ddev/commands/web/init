#!/usr/bin/env bash

## Description: Initialize TYPO3 dev instance for pagebased development
## Usage: init [flags]
## Example: "ddev init" or "ddev init --typo3 12" or "ddev init --force"
## Flags: [{"Name":"force","Shorthand":"f","Usage":"Force reinit even if TYPO3 is already configured"},{"Name":"skip-seed","Shorthand":"s","Usage":"Skip importing example seed data"},{"Name":"snapshot","Usage":"Create a DB snapshot after successful init"},{"Name":"typo3","Usage":"TYPO3 major version to install (12 or 13, default: use composer.lock)","DefValue":""}]

set -Eeuo pipefail

# Auto-proxy into DDEV if running outside the container
if [ -z "${IS_DDEV_PROJECT:-}" ]; then
    if command -v ddev >/dev/null 2>&1 && [ -d ".ddev" ]; then
        ddev exec bash -lc "/var/www/html/.ddev/commands/web/init $*"
        exit $?
    fi
fi

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; BLUE='\033[0;34m'; NC='\033[0m'
info()   { echo -e "${YELLOW}$*${NC}"; }
ok()     { echo -e "${GREEN}✓ $*${NC}"; }
err()    { echo -e "${RED}✗ $*${NC}"; }
header() { echo -e "\n${BLUE}━━━ $* ━━━${NC}"; }

FORCE=false; SKIP_SEED=false; CREATE_SNAPSHOT=false; TYPO3_VERSION=""

while [[ $# -gt 0 ]]; do
    case $1 in
        --force|-f)     FORCE=true ;;
        --skip-seed|-s) SKIP_SEED=true ;;
        --snapshot)     CREATE_SNAPSHOT=true ;;
        --typo3)
            shift
            TYPO3_VERSION="${1:-}"
            if [[ "$TYPO3_VERSION" != "13" && "$TYPO3_VERSION" != "14" ]]; then
                err "Invalid TYPO3 version: '$TYPO3_VERSION'. Use 13 or 14."
                exit 1
            fi
            ;;
        --help|-h)
            echo "Usage: ddev init [flags]"
            echo ""
            echo "Sets up a local TYPO3 instance for pagebased development."
            echo ""
            echo "Flags:"
            echo "  -f, --force        Reinitialize even if TYPO3 is already configured"
            echo "  -s, --skip-seed    Skip importing example pagebased pages"
            echo "      --snapshot     Create a DB snapshot after successful init"
            echo "      --typo3 <ver>  Install specific TYPO3 version (13 or 14)"
            echo ""
            echo "Examples:"
            echo "  ddev init                  # First-time setup (uses composer.lock)"
            echo "  ddev init --typo3 13       # Setup with TYPO3 v13"
            echo "  ddev init --typo3 14       # Setup with TYPO3 v14"
            echo "  ddev init --force          # Wipe and reinitialize"
            echo "  ddev init --skip-seed      # Setup without example data"
            exit 0
            ;;
    esac
    shift
done

TYPO3_BIN="/var/www/html/.build/bin/typo3"
SETTINGS_PHP="/var/www/html/config/system/settings.php"

echo ""
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  pagebased TYPO3 Initialization${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

# ─── Guard: already configured ───────────────────────────────────────────────
if [ -f "$SETTINGS_PHP" ] && [ "$FORCE" = false ]; then
    info "TYPO3 is already configured ($SETTINGS_PHP exists)."
    echo ""
    echo "Options:"
    echo "  ddev init --force          # Wipe and reinitialize"
    echo "  ddev snapshot restore      # Restore a previous snapshot"
    exit 0
fi

if [ "$FORCE" = true ] && [ -f "$SETTINGS_PHP" ]; then
    header "Cleanup"
    info "Removing existing TYPO3 configuration..."
    rm -rf /var/www/html/config /var/www/html/.build/public/typo3conf /var/www/html/var
    ok "Existing configuration removed"
fi

# ─── Step 1: Dependencies ─────────────────────────────────────────────────────
header "Step 1: Dependencies"
if [ -n "$TYPO3_VERSION" ]; then
    # v13 LTS is 13.4; v14's first release line is 14.0+ (no 14.4 yet)
    if [ "$TYPO3_VERSION" = "13" ]; then
        T3_CONSTRAINT="^13.4"
    else
        T3_CONSTRAINT="^14.0"
    fi
    info "Installing dependencies for TYPO3 v${TYPO3_VERSION} (${T3_CONSTRAINT})..."
    # The composer plugin runs "asset:publish" during the update. While switching TYPO3 major
    # versions, typo3/class-alias-loader differs between the old and new dependency set and the
    # alias-loader-include.php generated mid-update is stale (fatal: "Call to undefined method
    # ...setCaseSensitiveClassLoading()"), which makes asset:publish — and thus the update — exit
    # non-zero. Tolerate that, then regenerate the autoloader with the now-current plugin set, which
    # rewrites the include cleanly.
    cd /var/www/html && composer update \
        --with "typo3/cms-core:${T3_CONSTRAINT}" \
        --with "typo3/cms-install:${T3_CONSTRAINT}" \
        --no-interaction --no-progress --prefer-stable || true
    cd /var/www/html && composer dump-autoload --no-interaction
    ok "Dependencies installed (TYPO3 v${TYPO3_VERSION})"
elif [ ! -f "/var/www/html/.build/vendor/autoload.php" ]; then
    info "Running composer install..."
    cd /var/www/html && composer install --no-interaction --no-progress
    ok "Dependencies installed"
else
    ok "Dependencies already installed"
fi

# ─── Step 2: Database ─────────────────────────────────────────────────────────
header "Step 2: Database"
info "Waiting for database..."
for i in $(seq 1 15); do
    mysqladmin ping -h db -u root -proot --silent 2>/dev/null && break
    sleep 2
done

TABLE_COUNT=$(mysql -h db -u root -proot db -ss \
    -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = 'db';" 2>/dev/null || echo "0")

if [ "$TABLE_COUNT" -gt 0 ]; then
    info "Found $TABLE_COUNT existing tables — dropping for clean init..."
    DROPS=$(mysql -h db -u root -proot db -ss \
        -e "SELECT CONCAT('DROP TABLE IF EXISTS \`', table_name, '\`;') FROM information_schema.tables WHERE table_schema='db';" 2>/dev/null)
    mysql -h db -u root -proot db -e "SET FOREIGN_KEY_CHECKS=0; $DROPS SET FOREIGN_KEY_CHECKS=1;" 2>/dev/null
    ok "Database cleaned"
else
    ok "Database is empty"
fi

# ─── Step 3: TYPO3 Setup ──────────────────────────────────────────────────────
header "Step 3: TYPO3 Setup"
info "Running TYPO3 setup wizard..."
"$TYPO3_BIN" setup \
    --no-interaction \
    --driver=mysqli \
    --host=db \
    --port=3306 \
    --dbname=db \
    --username=root \
    --password=root \
    --admin-username=admin \
    --admin-user-password=Admin1234! \
    --admin-email=admin@example.com \
    --project-name="pagebased Development" \
    --create-site="https://pagebased.ddev.site/" \
    --server-type=other \
    --force

# Local dev: trust all host headers (ddev hostname + port-based URLs).
# Written to additional.php, which setup/install-tool never overwrites.
cat > /var/www/html/config/system/additional.php <<'PHP'
<?php
$GLOBALS['TYPO3_CONF_VARS']['SYS']['trustedHostsPattern'] = '.*';
PHP
ok "TYPO3 setup complete"

# ─── Step 4: Extensions & Schema ─────────────────────────────────────────────
header "Step 4: Extensions & Schema"
# extension:setup is not available in composer mode (calls extension:dumpclassloadinginformation
# which is disabled). typo3 setup already handles schema + extension activation.
"$TYPO3_BIN" cache:flush
ok "Extensions ready (schema applied by setup, caches flushed)"

# ─── Step 5: Seed data ────────────────────────────────────────────────────────
if [ "$SKIP_SEED" = false ]; then
    header "Step 5: Seed Data"
    /var/www/html/.ddev/commands/web/seed --force
    "$TYPO3_BIN" cache:flush
fi

# ─── Optional snapshot ────────────────────────────────────────────────────────
if [ "$CREATE_SNAPSHOT" = true ]; then
    header "Snapshot"
    ddev snapshot --name=initial-setup
    ok "Snapshot 'initial-setup' created"
fi

# ─── Done ─────────────────────────────────────────────────────────────────────
echo ""
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✓ Initialization complete!${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo "  TYPO3 Backend: https://pagebased.ddev.site/typo3"
echo "  Username:      admin"
echo "  Password:      Admin1234!"
echo ""
if [ -n "$TYPO3_VERSION" ]; then
echo "  TYPO3 Version: v${TYPO3_VERSION}"
fi
echo ""
echo "  ddev test              # Run tests"
echo "  ddev seed --force      # Reimport seed data"
echo "  ddev snapshot          # Create DB snapshot"
echo ""
